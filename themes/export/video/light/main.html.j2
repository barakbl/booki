<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --text: {{ theme_vars.text }};
  --accent: {{ theme_vars.accent }};
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.wrap { max-width: 1400px; margin: 0 auto; padding: 28px 22px 60px; }
h1 { font-size: 28px; margin: 0 0 6px; }
.meta {
  color: color-mix(in srgb, var(--text) 55%, transparent);
  font-size: 13px;
  margin-bottom: 22px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 16px;
}
.tile {
  background: color-mix(in srgb, var(--text) 5%, transparent);
  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
  border-radius: 10px;
  overflow: hidden;
  transition: transform 200ms, border-color 200ms;
}
.tile:hover {
  border-color: color-mix(in srgb, var(--accent) 50%, transparent);
}
.tile a {
  color: inherit;
  text-decoration: none;
  display: block;
}
.thumb {
  position: relative;
  aspect-ratio: 16 / 9;
  background: #000;
  overflow: hidden;
}
.thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: opacity 240ms;
}
.tile:hover .thumb img { opacity: 0.85; }
.thumb .placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 40px;
}
.play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  color: rgba(255, 255, 255, 0.92);
  opacity: 0.85;
  transition: opacity 200ms, transform 200ms;
  pointer-events: none;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}
.tile:hover .play { opacity: 1; transform: scale(1.1); }
.tile-meta { padding: 12px 14px; }
.tile-title {
  font-weight: 600;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tile-channel {
  color: color-mix(in srgb, var(--text) 60%, transparent);
  font-size: 12px;
}
.skipped {
  margin-top: 36px;
  padding: 14px 18px;
  background: color-mix(in srgb, #ef4444 12%, transparent);
  border: 1px solid color-mix(in srgb, #ef4444 30%, transparent);
  border-radius: 8px;
  font-size: 13px;
}
.skipped h2 { margin: 0 0 8px; font-size: 14px; color: #ef4444; }
.skipped ul { margin: 0; padding-left: 18px; }
.skipped li { margin: 2px 0; }
</style>
</head>
<body>
<main class="wrap">
  <h1>{{ title }}</h1>
  <p class="meta">{{ videos|length }} video{% if videos|length != 1 %}s{% endif %} · generated {{ generated_at }}</p>
  <div class="grid">
    {%- for v in videos %}
    <div class="tile">
      <a href="./{{ v.filename }}" target="_blank" rel="noopener">
        <div class="thumb">
          {% if v.thumb %}
            <img src="./{{ v.thumb }}" alt="{{ v.title }}" loading="lazy">
          {% else %}
            <span class="placeholder">🎬</span>
          {% endif %}
          <span class="play">▶</span>
        </div>
        <div class="tile-meta">
          <div class="tile-title">{{ v.title }}</div>
          {% if v.channel %}<div class="tile-channel">{{ v.channel }}</div>{% endif %}
        </div>
      </a>
    </div>
    {%- endfor %}
  </div>
  {% if skipped %}
  <section class="skipped">
    <h2>{{ skipped|length }} skipped</h2>
    <ul>
      {%- for s in skipped %}
      <li><strong>{{ s.title }}</strong> — {{ s.reason }}</li>
      {%- endfor %}
    </ul>
  </section>
  {% endif %}
</main>
</body>
</html>
