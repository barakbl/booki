<!DOCTYPE html>
<html lang="en"{% if rtl %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --text: {{ theme_vars.text }};
  --accent: {{ theme_vars.accent }};
  --secondary: {{ theme_vars.secondary or '#06b6d4' }};
  --muted: {{ theme_vars.muted or '#6b7280' }};
}
* { box-sizing: border-box; }
@keyframes rainbow-shift { 0% { background-position: 0% 50%; } 100% { background-position: 100% 50%; } }
@keyframes wiggle        { 0%,100% { transform: rotate(-2deg); } 50% { transform: rotate(2deg); } }
@keyframes pop-in {
  0% { opacity: 0; transform: scale(0.7) rotate(-3deg); }
  60% { opacity: 1; transform: scale(1.05) rotate(0); }
  100% { transform: scale(1); }
}
html, body {
  margin: 0; padding: 0;
  background:
    radial-gradient(circle at 10% 12%, color-mix(in srgb, var(--accent) 18%, transparent) 0, transparent 240px),
    radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--secondary) 22%, transparent) 0, transparent 280px),
    radial-gradient(circle at 50% 92%, color-mix(in srgb, #ec4899 18%, transparent) 0, transparent 320px),
    var(--bg);
  background-attachment: fixed;
  color: var(--text);
  font: 14px/1.4 "Comic Sans MS", "Comic Neue", "Marker Felt", "Chalkboard SE", "Bradley Hand", cursive;
  min-height: 100vh;
}
.wrap { padding: 24px; max-width: 1400px; margin: 0 auto; }
.fun-title {
  font-size: 40px; font-weight: 800; margin: 4px 0 6px; text-align: center;
  background: linear-gradient(90deg, #ec4899, #f59e0b, #10b981, #06b6d4, #8b5cf6);
  background-size: 200% 200%;
  -webkit-background-clip: text; background-clip: text; color: transparent;
  animation: rainbow-shift 7s linear infinite alternate;
}
.fun-meta { text-align: center; color: var(--muted); font-size: 13px; margin-bottom: 16px; }
input.filter {
  display: block; width: 100%; max-width: 520px; margin: 0 auto 22px;
  padding: 12px 18px; font: inherit; font-size: 16px;
  background: #fff; color: var(--text);
  border: 3px solid var(--accent); border-radius: 999px;
  outline: none;
  box-shadow: 0 4px 0 0 color-mix(in srgb, var(--accent) 35%, transparent);
}
input.filter:focus { border-color: var(--secondary); }

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 14px;
}
.tile {
  position: relative; aspect-ratio: 1; cursor: pointer;
  overflow: hidden; border-radius: 18px;
  background: #fff;
  border: 3px solid var(--accent);
  box-shadow: 4px 4px 0 0 color-mix(in srgb, var(--accent) 35%, transparent);
  animation: pop-in 350ms ease-out backwards;
  transition: transform 140ms ease, box-shadow 140ms;
}
.tile:nth-child(odd)  { transform: rotate(-1.5deg); }
.tile:nth-child(even) { transform: rotate(1.5deg); }
.tile:hover {
  transform: rotate(0) scale(1.03);
  border-color: var(--secondary);
  box-shadow: 6px 6px 0 0 color-mix(in srgb, var(--secondary) 50%, transparent);
}
.tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
.tile.error {
  display: flex; align-items: center; justify-content: center;
  color: var(--muted); font-size: 12px; padding: 12px; text-align: center;
}
.tile-cap {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 8px 10px;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.65), transparent);
  color: #fff; font-size: 12px; opacity: 0; transition: opacity 200ms;
  pointer-events: none;
}
.tile:hover .tile-cap { opacity: 1; }

.lightbox {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.92);
  display: none; align-items: center; justify-content: center; z-index: 100;
}
.lightbox.open { display: flex; }
.lightbox img { max-width: 92vw; max-height: 88vh; object-fit: contain; border: 4px solid #fff; border-radius: 14px; }
.lightbox-cap { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); color: #fff; font-size: 14px; }
.lb-btn {
  position: absolute; background: #fff; color: var(--accent);
  border: 3px solid var(--accent); border-radius: 999px;
  width: 48px; height: 48px;
  font-size: 24px; cursor: pointer;
}
.lb-close { top: 16px; right: 16px; }
.lb-prev  { top: 50%; left: 16px;  transform: translateY(-50%); }
.lb-next  { top: 50%; right: 16px; transform: translateY(-50%); }

.empty {
  text-align: center; color: var(--muted);
  margin-top: 24px; font-size: 16px;
}
.empty::before { content: "🐝 "; }

.page-footer {
  margin-top: 30px; text-align: center; padding: 14px 18px;
  background: #fff; color: var(--muted);
  border: 3px dashed var(--secondary); border-radius: 18px;
  transform: rotate(-0.5deg);
  font-size: 14px;
}
.page-footer::before { content: "🌈 "; }
.page-footer::after { content: " 🌈"; }

[dir="rtl"] .tile-cap { unicode-bidi: plaintext; }

@media (prefers-reduced-motion: reduce) {
  .fun-title, .tile { animation: none !important; }
  .tile:nth-child(odd), .tile:nth-child(even) { transform: none; }
}
</style>
</head>
<body>
<main class="wrap">
  <h1 class="fun-title">🌟 {{ title }} 🌟</h1>
  <p class="fun-meta">🎈 {{ item_count }} photo{% if item_count != 1 %}s{% endif %} · generated {{ generated_at }}</p>
  {% if show_search %}<input class="filter" type="search" id="filter" placeholder="🔍 type to find…">{% endif %}
  <div class="grid" id="grid">
    {%- for p in photos %}
    <div class="tile{% if not p.src %} error{% endif %}" data-search="{{ ((p.title or '') ~ ' ' ~ (p.url or '') ~ ' ' ~ ((p.tags or [])|join(' ')))|lower }}"
         data-src="{{ p.src or '' }}" data-title="{{ p.title or '' }}" data-url="{{ p.url or '' }}">
      {% if p.src %}<img loading="lazy" src="{{ p.src }}" alt="{{ p.title }}">{% else %}<span>{{ p.error or 'unavailable' }}</span>{% endif %}
      {% if p.title %}<div class="tile-cap">{{ p.title }}</div>{% endif %}
    </div>
    {%- endfor %}
  </div>
  <p class="empty" id="empty" hidden>nothing here yet — try another word</p>
  {% if footer_text %}<footer class="page-footer">{{ footer_text }}</footer>{% endif %}
</main>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button type="button" class="lb-btn lb-close" id="lbClose" aria-label="Close">✕</button>
  <button type="button" class="lb-btn lb-prev" id="lbPrev" aria-label="Previous">‹</button>
  <button type="button" class="lb-btn lb-next" id="lbNext" aria-label="Next">›</button>
  <img id="lbImg" alt="">
  <div class="lightbox-cap" id="lbCap"></div>
</div>

<script>
const tiles = [...document.querySelectorAll('.tile[data-src]:not(.error)')];
const lb = document.getElementById('lightbox');
const lbImg = document.getElementById('lbImg');
const lbCap = document.getElementById('lbCap');
let idx = 0;
function visibleTiles() { return tiles.filter(t => t.style.display !== 'none' && t.dataset.src); }
function open(i) {
  const v = visibleTiles(); if (!v.length) return;
  idx = (i + v.length) % v.length;
  const t = v[idx];
  lbImg.src = t.dataset.src; lbImg.alt = t.dataset.title || '';
  lbCap.textContent = (t.dataset.title || '') + '   ' + (idx + 1) + ' / ' + v.length;
  lb.classList.add('open');
}
function close() { lb.classList.remove('open'); }
tiles.forEach((t, i) => t.addEventListener('click', () => {
  const v = visibleTiles(); const j = v.indexOf(t);
  if (j >= 0) open(j);
}));
document.getElementById('lbClose').addEventListener('click', close);
document.getElementById('lbPrev').addEventListener('click',  () => open(idx - 1));
document.getElementById('lbNext').addEventListener('click',  () => open(idx + 1));
lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
document.addEventListener('keydown', (e) => {
  if (lb.classList.contains('open')) {
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') open(idx + 1);
    else if (e.key === 'ArrowLeft') open(idx - 1);
  }
});
{% if show_search %}
const f = document.getElementById('filter');
const empty = document.getElementById('empty');
f.addEventListener('input', () => {
  const q = f.value.trim().toLowerCase();
  let any = false;
  document.querySelectorAll('.tile').forEach(t => {
    const hit = !q || t.dataset.search.includes(q);
    t.style.display = hit ? '' : 'none';
    if (hit) any = true;
  });
  empty.hidden = any;
});
{% endif %}
</script>
</body>
</html>
