<!DOCTYPE html>
<html lang="en"{% if rtl %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --text: {{ theme_vars.text }};
  --accent: {{ theme_vars.accent }};
  --secondary: {{ theme_vars.secondary or theme_vars.accent }};
  --muted: {{ theme_vars.muted or 'color-mix(in srgb, ' ~ theme_vars.text ~ ' 55%, transparent)' }};
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.wrap { padding: 24px; max-width: 1400px; margin: 0 auto; }
h1 { font-size: 28px; margin: 0 0 6px; }
.meta { color: var(--muted); font-size: 13px; margin-bottom: 18px; }
.filter {
  width: 100%;
  padding: 10px 14px;
  font: inherit;
  border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
  border-radius: 8px;
  background: color-mix(in srgb, var(--bg) 90%, var(--text) 4%);
  color: var(--text);
  margin-bottom: 22px;
  outline: none;
  transition: border-color 120ms;
}
.filter:focus { border-color: var(--secondary); }
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 12px;
}
.tile {
  position: relative;
  cursor: pointer;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8px;
  background: color-mix(in srgb, var(--text) 8%, transparent);
}
.tile img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 240ms ease-out;
}
.tile:hover img { transform: scale(1.04); }
.tile-cap {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8px 10px;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.65), transparent);
  color: #fff;
  font-size: 12px;
  opacity: 0;
  transition: opacity 200ms;
  pointer-events: none;
}
.tile:hover .tile-cap { opacity: 1; }
.tile.error {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 11px;
  padding: 8px;
  text-align: center;
  cursor: default;
}
.lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.92);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.lightbox.open { display: flex; }
.lightbox img {
  max-width: 92vw;
  max-height: 88vh;
  object-fit: contain;
}
.lightbox-cap {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 6px 14px;
  border-radius: 6px;
  max-width: 80vw;
  text-align: center;
  font-size: 13px;
}
.lb-btn {
  position: absolute;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  width: 44px;
  height: 44px;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}
.lb-btn:hover { background: rgba(255, 255, 255, 0.2); }
.lb-close { top: 18px; right: 18px; }
.lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
.lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
.empty { color: var(--muted); margin-top: 20px; }
.page-footer {
  margin-top: 32px; padding-top: 14px; text-align: center;
  border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
  color: var(--muted); font-size: 12px;
}
[dir="rtl"] .tile-cap { unicode-bidi: plaintext; }
</style>
</head>
<body>
<main class="wrap">
  <h1>{{ title }}</h1>
  <p class="meta">{{ item_count }} photo{% if item_count != 1 %}s{% endif %} · generated {{ generated_at }}</p>
  {% if show_search %}<input class="filter" type="search" id="filter" placeholder="Filter photos…">{% endif %}
  <div class="grid" id="grid">
    {%- for p in photos %}
    <div class="tile{% if not p.src %} error{% endif %}"
         data-search="{{ ((p.title or '') ~ ' ' ~ (p.url or '') ~ ' ' ~ (p.tags|join(' ')) ~ ' ' ~ (p.summary or ''))|lower }}"
         data-src="{{ p.src or '' }}"
         data-title="{{ p.title or '' }}"
         data-url="{{ p.url or '' }}">
      {% if p.src %}<img loading="lazy" src="{{ p.src }}" alt="{{ p.title }}">{% else %}<span>{{ p.error or 'unavailable' }}</span>{% endif %}
      {% if p.title %}<div class="tile-cap">{{ p.title }}</div>{% endif %}
    </div>
    {%- endfor %}
  </div>
  <p class="empty" id="empty" hidden>No matches.</p>
  {% if footer_text %}<footer class="page-footer">{{ footer_text }}</footer>{% endif %}
</main>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button type="button" class="lb-btn lb-close" id="lbClose" aria-label="Close">✕</button>
  <button type="button" class="lb-btn lb-prev" id="lbPrev" aria-label="Previous">‹</button>
  <button type="button" class="lb-btn lb-next" id="lbNext" aria-label="Next">›</button>
  <img id="lbImg" alt="">
  <div class="lightbox-cap" id="lbCap"></div>
</div>

<script>
const lb = document.getElementById('lightbox');
const lbImg = document.getElementById('lbImg');
const lbCap = document.getElementById('lbCap');
let visibleTiles = [];
let idx = 0;

function getVisibleTiles() {
  return Array.from(document.querySelectorAll('.tile'))
    .filter(t => t.dataset.src && t.style.display !== 'none');
}

function showAt(i) {
  if (!visibleTiles.length) return;
  idx = (i + visibleTiles.length) % visibleTiles.length;
  const t = visibleTiles[idx];
  lbImg.src = t.dataset.src;
  lbCap.textContent = t.dataset.title || t.dataset.url || '';
}

function openLightbox(t) {
  visibleTiles = getVisibleTiles();
  const j = visibleTiles.indexOf(t);
  if (j < 0) return;
  showAt(j);
  lb.classList.add('open');
  lb.setAttribute('aria-hidden', 'false');
}

function closeLightbox() {
  lb.classList.remove('open');
  lb.setAttribute('aria-hidden', 'true');
  lbImg.src = '';
}

document.querySelectorAll('.tile').forEach(t => {
  t.addEventListener('click', () => { if (t.dataset.src) openLightbox(t); });
});
document.getElementById('lbClose').addEventListener('click', closeLightbox);
document.getElementById('lbPrev').addEventListener('click', () => showAt(idx - 1));
document.getElementById('lbNext').addEventListener('click', () => showAt(idx + 1));
lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
document.addEventListener('keydown', e => {
  if (!lb.classList.contains('open')) return;
  if (e.key === 'Escape') closeLightbox();
  else if (e.key === 'ArrowLeft') showAt(idx - 1);
  else if (e.key === 'ArrowRight') showAt(idx + 1);
});

const filter = document.getElementById('filter');
const empty = document.getElementById('empty');
if (filter) {
  filter.focus();
  filter.addEventListener('input', () => {
    const q = filter.value.trim().toLowerCase();
    let any = false;
    document.querySelectorAll('.tile').forEach(t => {
      const hit = !q || (t.dataset.search || '').includes(q);
      t.style.display = hit ? '' : 'none';
      if (hit) any = true;
    });
    empty.hidden = any;
  });
}
</script>
</body>
</html>
