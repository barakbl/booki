<!DOCTYPE html>
<html lang="en"{% if rtl %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --fg: {{ theme_vars.text }};
  --accent: {{ theme_vars.accent }};
  --secondary: {{ theme_vars.secondary or theme_vars.accent }};
  --muted: {{ theme_vars.muted or 'color-mix(in srgb, ' ~ theme_vars.text ~ ' 50%, transparent)' }};
  --border: color-mix(in srgb, var(--fg) 24%, transparent);
  --dim: var(--muted);
  --sel-bg: color-mix(in srgb, var(--secondary) 22%, transparent);
}
* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  background: var(--bg); color: var(--fg);
  font: 14px/1.45 "JetBrains Mono", "SF Mono", "Fira Code", "Menlo", monospace;
  min-height: 100vh;
}
::selection { background: var(--accent); color: var(--bg); }

.tui { max-width: 1400px; margin: 0 auto; padding: 18px 18px 80px; }

.tui-block { position: relative; border: 1px solid var(--border); margin-bottom: 14px; }
.tui-block-title {
  position: absolute; top: -10px; left: 14px;
  background: var(--bg); padding: 0 10px;
  color: var(--accent); font-weight: 700; letter-spacing: 0.04em;
}
.tui-block-body { padding: 14px 16px; }
.tui-page-footer {
  margin-top: 18px; padding-top: 10px; text-align: center;
  color: var(--dim); font-size: 12px; border-top: 1px dashed var(--border);
}
[dir="rtl"] body { text-align: right; }

.tui-input {
  display: flex; align-items: center; gap: 8px;
  border: 1px solid var(--border); padding: 4px 10px; margin-bottom: 14px;
}
.tui-input::before { content: "▶"; color: var(--secondary); font-size: 11px; }
.tui-input input {
  flex: 1; background: transparent; border: none; outline: none;
  color: var(--fg); font: inherit;
}
.tui-input input::placeholder { color: var(--dim); }

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 8px;
}
.tile {
  position: relative;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--fg) 4%, transparent);
  cursor: zoom-in;
  transition: border-color 120ms, transform 120ms;
}
.tile:hover { border-color: var(--secondary); transform: translateY(-1px); }
.tile-num {
  position: absolute; top: 4px; left: 6px;
  background: color-mix(in srgb, var(--bg) 80%, transparent);
  color: var(--accent);
  padding: 0 6px;
  font-size: 11px;
  font-weight: 700;
}
.tile-imp {
  position: absolute; top: 4px; right: 6px;
  color: var(--accent);
  background: color-mix(in srgb, var(--bg) 80%, transparent);
  padding: 0 6px;
  font-size: 11px;
}
.tile-img-wrap {
  aspect-ratio: 1 / 1;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  background: var(--bg);
}
.tile-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.tile-error {
  color: var(--dim); font-size: 12px; text-align: center; padding: 24px 12px;
}
.tile-meta {
  padding: 6px 8px;
  border-top: 1px dashed color-mix(in srgb, var(--fg) 18%, transparent);
  font-size: 12px;
}
.tile-title {
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tile-tags {
  margin-top: 2px;
  color: var(--accent);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.lightbox {
  position: fixed; inset: 0; z-index: 100;
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  display: none; align-items: center; justify-content: center;
  padding: 24px;
}
.lightbox.open { display: flex; }
.lightbox-frame {
  position: relative;
  max-width: min(96vw, 1300px);
  max-height: 92vh;
  border: 1px solid var(--accent);
  background: var(--bg);
  display: flex; flex-direction: column;
}
.lightbox-title {
  position: absolute; top: -10px; left: 14px;
  background: var(--bg); padding: 0 10px; color: var(--accent);
  font-weight: 700; max-width: 80%;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lightbox img { max-width: 100%; max-height: 80vh; object-fit: contain; padding: 12px; display: block; }
.lightbox-bar {
  display: flex; align-items: center; gap: 16px;
  padding: 6px 14px; border-top: 1px solid var(--border);
  background: var(--accent); color: var(--bg); font-weight: 700;
}
.lightbox-bar .key {
  background: color-mix(in srgb, var(--bg) 75%, var(--accent) 25%);
  color: var(--accent); padding: 0 6px; margin-right: 4px;
}
.lightbox-bar .right { margin-left: auto; }
</style>
</head>
<body>
<main class="tui">
  <div class="tui-block">
    <span class="tui-block-title">┤ {{ title }} ├</span>
    <div class="tui-block-body">
      {% if show_search %}
      <div class="tui-input">
        <input id="filter" type="search" placeholder="filter…">
      </div>
      {% endif %}
      <div class="grid" id="grid">
        {%- for p in photos %}
        <figure class="tile" data-search="{{ ((p.title or '') ~ ' ' ~ (p.url or '') ~ ' ' ~ ((p.tags or [])|join(' ')))|lower }}"
                data-src="{{ p.src or '' }}" data-title="{{ p.title or '' }}">
          <span class="tile-num">{{ '%03d' | format(loop.index) }}</span>
          {% if p.importance %}<span class="tile-imp">★{{ p.importance }}</span>{% endif %}
          <div class="tile-img-wrap">
            {% if p.src %}<img src="{{ p.src }}" alt="{{ p.title }}" loading="lazy">
            {% else %}<div class="tile-error">{{ p.error or 'no image' }}</div>{% endif %}
          </div>
          <figcaption class="tile-meta">
            <div class="tile-title">{{ p.title or '(untitled)' }}</div>
            {% if p.tags %}<div class="tile-tags">[{{ p.tags|join(' ') }}]</div>{% endif %}
          </figcaption>
        </figure>
        {%- endfor %}
      </div>
      {% if footer_text %}<div class="tui-page-footer">─ {{ footer_text }} ─</div>{% endif %}
    </div>
  </div>
</main>

<div class="lightbox" id="lb" role="dialog" aria-modal="true">
  <div class="lightbox-frame">
    <span class="lightbox-title" id="lbTitle">─</span>
    <img id="lbImg" alt="">
    <div class="lightbox-bar">
      <span><span class="key">←/→</span> nav</span>
      <span><span class="key">ESC</span> close</span>
      <span class="right" id="lbCount"></span>
    </div>
  </div>
</div>

<script>
const tiles = [...document.querySelectorAll('.tile')];
const lb = document.getElementById('lb');
const lbImg = document.getElementById('lbImg');
const lbTitle = document.getElementById('lbTitle');
const lbCount = document.getElementById('lbCount');
let idx = 0;

function visibleTiles() {
  return tiles.filter(t => t.style.display !== 'none' && t.dataset.src);
}
function open(i) {
  const v = visibleTiles();
  if (!v.length) return;
  idx = (i + v.length) % v.length;
  const t = v[idx];
  lbImg.src = t.dataset.src;
  lbImg.alt = t.dataset.title || '';
  lbTitle.textContent = '┤ ' + (t.dataset.title || '(untitled)') + ' ├';
  lbCount.textContent = (idx + 1) + ' / ' + v.length;
  lb.classList.add('open');
}
function close() { lb.classList.remove('open'); }

tiles.forEach((t, i) => t.addEventListener('click', () => {
  const v = visibleTiles(); const j = v.indexOf(t);
  if (j >= 0) open(j);
}));
lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

document.addEventListener('keydown', (e) => {
  if (lb.classList.contains('open')) {
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') open(idx + 1);
    else if (e.key === 'ArrowLeft') open(idx - 1);
    return;
  }
  const f = document.getElementById('filter');
  if (e.key === '/' && document.activeElement !== f) { e.preventDefault(); f?.focus(); }
});

const f = document.getElementById('filter');
f?.addEventListener('input', () => {
  const q = f.value.trim().toLowerCase();
  tiles.forEach(t => {
    t.style.display = (!q || t.dataset.search.includes(q)) ? '' : 'none';
  });
});
</script>
</body>
</html>
