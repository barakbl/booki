<!DOCTYPE html>
<html lang="en"{% if rtl %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --fg: {{ theme_vars.text }};
  --link: {{ theme_vars.link }};
  --accent: {{ theme_vars.accent }};
  --secondary: {{ theme_vars.secondary or theme_vars.accent }};
  --muted: {{ theme_vars.muted or 'color-mix(in srgb, ' ~ theme_vars.text ~ ' 50%, transparent)' }};
  --border: color-mix(in srgb, var(--fg) 24%, transparent);
  --dim: var(--muted);
  --sel-bg: color-mix(in srgb, var(--secondary) 22%, transparent);
}
* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  background: var(--bg); color: var(--fg);
  font: 14px/1.45 "JetBrains Mono", "SF Mono", "Fira Code", "Menlo", "Consolas", monospace;
  min-height: 100vh;
}
::selection { background: var(--accent); color: var(--bg); }

.tui {
  max-width: 1100px;
  margin: 0 auto;
  padding: 18px 18px 80px;
}

.tui-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 12px;
  font-size: 13px;
}
.tui-tab {
  padding: 4px 14px;
  border: 1px solid var(--border);
  border-bottom: none;
  margin-right: 1px;
  color: var(--dim);
  cursor: default;
}
.tui-tab.active {
  background: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
  font-weight: 700;
}
.tui-tab .key { text-decoration: underline; text-underline-offset: 2px; }

.tui-block {
  position: relative;
  border: 1px solid var(--border);
  margin-bottom: 14px;
}
.tui-block-title {
  position: absolute;
  top: -10px;
  left: 14px;
  background: var(--bg);
  padding: 0 10px;
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.04em;
}
.tui-block-body {
  padding: 14px 16px;
}

.tui-input {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  padding: 4px 10px;
  margin-bottom: 14px;
  background: color-mix(in srgb, var(--fg) 4%, transparent);
}
.tui-input::before {
  content: "▶";
  color: var(--secondary);
  margin-right: 8px;
  font-size: 11px;
}
.tui-input input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--fg);
  font: inherit;
}
.tui-input input::placeholder { color: var(--dim); }
.tui-input::after {
  content: "▎";
  color: var(--accent);
  animation: tui-blink 1s steps(2) infinite;
}
@keyframes tui-blink { 50% { opacity: 0; } }

.tui-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.tui-row {
  display: grid;
  grid-template-columns: 4ch 2ch 1fr auto auto;
  gap: 10px;
  align-items: baseline;
  padding: 2px 10px;
  border-left: 2px solid transparent;
}
.tui-row:hover {
  background: var(--sel-bg);
  border-left-color: var(--secondary);
}
.tui-row + .tui-row { border-top: 1px dashed color-mix(in srgb, var(--fg) 8%, transparent); }
.tui-row-num { color: var(--dim); text-align: right; font-variant-numeric: tabular-nums; }
.tui-row-glyph { color: var(--secondary); }
.tui-row-title {
  color: var(--link);
  text-decoration: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tui-row-title:hover { text-decoration: underline; }
.tui-row-imp { color: var(--accent); font-weight: 700; }
.tui-row-tags { color: var(--accent); white-space: nowrap; }
.tui-row-url {
  grid-column: 3 / span 3;
  color: var(--dim);
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tui-row-summary {
  grid-column: 3 / span 3;
  color: color-mix(in srgb, var(--fg) 78%, transparent);
  font-size: 13px;
  white-space: normal;
}

.tui-group + .tui-group { margin-top: 10px; }
.tui-group-title {
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.05em;
  margin: 12px 0 4px;
}
.tui-group-title::before { content: "── "; color: var(--border); }

.tui-statusbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 4px 16px;
  background: var(--accent);
  color: var(--bg);
  font-weight: 700;
  font-size: 13px;
  border-top: 1px solid var(--accent);
}
.tui-statusbar .key {
  background: color-mix(in srgb, var(--bg) 75%, var(--accent) 25%);
  color: var(--accent);
  padding: 0 6px;
  margin-right: 4px;
}
.tui-statusbar .right {
  margin-left: auto;
  display: flex;
  gap: 14px;
  font-weight: 600;
}

.tui-empty { color: var(--dim); padding: 18px; text-align: center; }
.tui-page-footer {
  margin-top: 18px; padding-top: 10px; text-align: center;
  color: var(--dim); font-size: 12px;
  border-top: 1px dashed var(--border);
}
/* RTL: dir="rtl" on <html> already mirrors flexbox + text-align +
   inputs. Tweaks:
   - URL strings stay LTR via inline <bdi> in the template.
   - The numeric "001" column stays LTR in any direction.
   - The "[#tag]" pseudo-tags use a fixed LTR run via .tui-row-tags
     below so brackets and "#" don't get split by RTL bidi. */
[dir="rtl"] .tui-row-num,
[dir="rtl"] .tui-row-tags,
[dir="rtl"] .tui-row-imp { direction: ltr; unicode-bidi: isolate; }
</style>
</head>
<body>
<main class="tui">
  <nav class="tui-tabs" aria-hidden="true">
    <span class="tui-tab active"><span class="key">L</span>inks</span>
    <span class="tui-tab"><span class="key">F</span>ilter</span>
    <span class="tui-tab"><span class="key">H</span>elp</span>
  </nav>

  <div class="tui-block">
    <span class="tui-block-title">┤ {{ title }} ├</span>
    <div class="tui-block-body">
      {% if show_search %}
      <div class="tui-input">
        <input id="filter" type="search" placeholder="filter… (title · url · tag)">
      </div>
      {% endif %}
      <div id="results">
{%- for g in groups %}
        <section class="tui-group" data-group="{{ g.name }}">
{%- if g.name %}
          <h2 class="tui-group-title">{{ g.name }}</h2>
{%- endif %}
          <ul class="tui-list">
{%- set ns = namespace(idx=0) %}
{%- for it in g['items'] %}
{%- set ns.idx = ns.idx + 1 %}
            <li class="tui-row" data-search="{{ ((it.title or '') ~ ' ' ~ (it.url or '') ~ ' ' ~ ((it.tags or [])|join(' ')) ~ ' ' ~ (it.summary or ''))|lower }}">
              <span class="tui-row-num">{{ '%03d' | format(ns.idx) }}</span>
              <span class="tui-row-glyph">{{ it.kind|glyph }}</span>
              <a class="tui-row-title" href="{{ it.url|safe_href }}" target="_blank" rel="noopener">{{ it.title or '(untitled)' }}</a>
              {% if it.importance %}<span class="tui-row-imp">★{{ it.importance }}</span>{% else %}<span></span>{% endif %}
              {% if it.tags %}<span class="tui-row-tags">[{{ it.tags|join(' ') }}]</span>{% else %}<span></span>{% endif %}
              <span class="tui-row-url"><bdi>{{ it.url }}</bdi></span>
              {% if it.summary %}<span class="tui-row-summary">{{ it.summary }}</span>{% endif %}
            </li>
{%- endfor %}
          </ul>
        </section>
{%- endfor %}
      </div>
      <p class="tui-empty" id="empty" hidden>── no matches ──</p>
      {% if footer_text %}<div class="tui-page-footer">─ {{ footer_text }} ─</div>{% endif %}
    </div>
  </div>
</main>

<footer class="tui-statusbar">
  {% if show_search %}<span><span class="key">/</span> filter</span>{% endif %}
  <span><span class="key">↵</span> open</span>
  {% if show_search %}<span><span class="key">ESC</span> clear</span>{% endif %}
  <span><span class="key">F1</span> help</span>
  <span class="right">
    <span><bdi>{{ item_count }} items</bdi></span>
    <span><bdi>{{ generated_at }}</bdi></span>
  </span>
</footer>

{% if show_search %}
<script>
const f = document.getElementById('filter');
const empty = document.getElementById('empty');
f.focus();
function applyFilter() {
  const q = f.value.trim().toLowerCase();
  let any = false;
  document.querySelectorAll('.tui-row').forEach(li => {
    const hit = !q || li.dataset.search.includes(q);
    li.style.display = hit ? '' : 'none';
    if (hit) any = true;
  });
  document.querySelectorAll('.tui-group').forEach(g => {
    const visible = Array.from(g.querySelectorAll('.tui-row'))
                         .some(li => li.style.display !== 'none');
    g.style.display = visible ? '' : 'none';
  });
  empty.hidden = any;
}
f.addEventListener('input', applyFilter);
document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== f) { e.preventDefault(); f.focus(); }
  else if (e.key === 'Escape') { f.value = ''; applyFilter(); f.blur(); }
});
</script>
{% endif %}
</body>
</html>
