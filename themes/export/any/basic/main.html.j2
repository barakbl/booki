<!DOCTYPE html>
<html lang="en"{% if rtl %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --text: {{ theme_vars.text }};
  --link: {{ theme_vars.link }};
  --accent: {{ theme_vars.accent }};
  --secondary: {{ theme_vars.secondary or theme_vars.accent }};
  --muted: {{ theme_vars.muted or 'color-mix(in srgb, ' ~ theme_vars.text ~ ' 55%, transparent)' }};
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
}
.wrap {
  max-width: 920px;
  margin: 0 auto;
  padding: 36px 24px 80px;
}
h1 {
  font-size: 28px;
  margin: 0 0 6px;
}
.meta {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 22px;
}
input.filter {
  width: 100%;
  padding: 10px 14px;
  font: inherit;
  border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
  border-radius: 8px;
  background: color-mix(in srgb, var(--bg) 90%, var(--text) 4%);
  color: var(--text);
  margin-bottom: 24px;
  outline: none;
  transition: border-color 120ms;
}
input.filter:focus { border-color: var(--accent); }
.group-name {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin: 28px 0 8px;
  padding-bottom: 6px;
  border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
}
.links {
  list-style: none;
  padding: 0;
  margin: 0;
}
.item {
  padding: 12px 0;
  border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
}
.item-head {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}
.item-glyph { font-size: 16px; }
.item-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--link);
  text-decoration: none;
}
.item-title:hover { text-decoration: underline; }
.item-imp {
  font-size: 13px;
  font-weight: 600;
  color: var(--accent);
}
.item-source {
  font-size: 12px;
  color: var(--muted);
}
.item-url {
  font-size: 12px;
  color: var(--muted);
  word-break: break-all;
  margin-top: 2px;
}
.item-summary {
  margin-top: 5px;
  color: color-mix(in srgb, var(--text) 78%, transparent);
  /* Each summary picks its own direction from its content, so an
     English sentence in an RTL page keeps its period at the end of
     the line instead of being yanked to the visual left edge. */
  unicode-bidi: plaintext;
}
.item-imp, .item-source { unicode-bidi: isolate; }
.tags {
  margin-top: 6px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.tag {
  font-size: 11px;
  padding: 2px 9px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--secondary) 14%, transparent);
  color: var(--secondary);
  /* The "#" prefix is rendered inside the chip; force LTR so it always
     anchors to the start (left), regardless of the page or tag-text
     direction. RTL tag content (Hebrew / Arabic) still renders RTL
     inside the chip — the bidi algorithm treats it as its own run. */
  direction: ltr;
  unicode-bidi: isolate;
}
.tag::before { content: "#"; opacity: 0.65; margin-inline-end: 1px; }
.empty {
  color: var(--muted);
  margin-top: 20px;
}
.page-footer {
  margin-top: 40px;
  padding-top: 16px;
  border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
  color: var(--muted);
  font-size: 12px;
  text-align: center;
}

/* ─── RTL adjustments ─────────────────────────────────────────────── */
/* `dir="rtl"` on <html> already mirrors flexbox / text-align / inputs.
   - URLs and the meta line stay LTR via <bdi> in the template (URL
     strings would otherwise split around `:` and `/`).
   - Tag chips force LTR + isolate so the leading "#" stays at the
     start of each chip regardless of page direction.
   - Summaries use `unicode-bidi: plaintext` so each one's direction
     follows its content. An English summary in an RTL page keeps
     its period at the visual end of the sentence rather than being
     yanked to the line's left edge by the surrounding RTL paragraph
     direction. The downside (English summaries now left-align in an
     RTL page) is the lesser evil — broken punctuation is uglier
     than a paragraph that aligns with its own writing direction. */
[dir="rtl"] .group-name { letter-spacing: 0; }
</style>
</head>
<body>
<main class="wrap">
  <h1>{{ title }}</h1>
  <p class="meta"><bdi>{{ item_count }} item{% if item_count != 1 %}s{% endif %} · generated {{ generated_at }}</bdi></p>
  {% if show_search %}<input class="filter" type="search" id="filter" placeholder="Filter… (title, URL, tag, summary)">{% endif %}
  <div id="results">
{%- for g in groups %}
    <section class="group" data-group="{{ g.name }}">
{%- if g.name %}
      <h2 class="group-name">{{ g.name }}</h2>
{%- endif %}
      <ul class="links">
{%- for it in g['items'] %}
        <li class="item" data-search="{{ ((it.title or '') ~ ' ' ~ (it.url or '') ~ ' ' ~ ((it.tags or [])|join(' ')) ~ ' ' ~ (it.summary or ''))|lower }}">
          <div class="item-head">
            <span class="item-glyph">{{ it.kind|glyph }}</span>
            <a class="item-title" href="{{ it.url }}" target="_blank" rel="noopener"><bdi>{{ it.title or '(untitled)' }}</bdi></a>
            {% if it.importance %}<span class="item-imp"><bdi>★{{ it.importance }}</bdi></span>{% endif %}
            {% if it.source %}<span class="item-source"><bdi>{{ it.source }}</bdi></span>{% endif %}
          </div>
          <div class="item-url"><bdi>{{ it.url }}</bdi></div>
          {% if it.summary %}<div class="item-summary">{{ it.summary }}</div>{% endif %}
          {% if it.tags %}<div class="tags">{% for t in it.tags %}<span class="tag"><bdi>{{ t }}</bdi></span>{% endfor %}</div>{% endif %}
        </li>
{%- endfor %}
      </ul>
    </section>
{%- endfor %}
  </div>
  <p class="empty" id="empty" hidden>No matches.</p>
  {% if footer_text %}<footer class="page-footer">{{ footer_text }}</footer>{% endif %}
</main>
{% if show_search %}
<script>
const f = document.getElementById('filter');
const empty = document.getElementById('empty');
f.focus();
f.addEventListener('input', () => {
  const q = f.value.trim().toLowerCase();
  const items = document.querySelectorAll('.item');
  let any = false;
  items.forEach(li => {
    const hit = !q || li.dataset.search.includes(q);
    li.style.display = hit ? '' : 'none';
    if (hit) any = true;
  });
  document.querySelectorAll('.group').forEach(g => {
    const visible = Array.from(g.querySelectorAll('.item'))
                         .some(li => li.style.display !== 'none');
    g.style.display = visible ? '' : 'none';
  });
  empty.hidden = any;
});
</script>
{% endif %}
</body>
</html>
