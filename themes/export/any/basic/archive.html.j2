<!DOCTYPE html>
<html lang="en"{% if rtl %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: {{ theme_vars.bg }};
  --text: {{ theme_vars.text }};
  --link: {{ theme_vars.link }};
  --accent: {{ theme_vars.accent }};
  --secondary: {{ theme_vars.secondary or theme_vars.accent }};
  --muted: {{ theme_vars.muted or 'color-mix(in srgb, ' ~ theme_vars.text ~ ' 55%, transparent)' }};
  --danger: {{ theme_vars.danger or '#ef4444' }};
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
}
.wrap { max-width: 980px; margin: 0 auto; padding: 36px 22px 80px; }
h1 { font-size: 28px; margin: 0 0 6px; }
.meta {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 22px;
}
input.filter {
  width: 100%;
  padding: 10px 14px;
  font: inherit;
  border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
  border-radius: 8px;
  background: color-mix(in srgb, var(--bg) 90%, var(--text) 4%);
  color: var(--text);
  margin-bottom: 22px;
  outline: none;
}
input.filter:focus { border-color: var(--accent); }
.items {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.item {
  display: grid;
  grid-template-columns: 88px 1fr;
  gap: 14px;
  padding: 12px;
  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
  border-radius: 10px;
  background: color-mix(in srgb, var(--text) 4%, transparent);
}
.thumb {
  width: 88px; height: 56px;
  border-radius: 6px;
  background: color-mix(in srgb, var(--text) 8%, transparent);
  display: flex; align-items: center; justify-content: center;
  font-size: 26px;
  overflow: hidden;
}
.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.head {
  display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
}
.title { font-weight: 600; color: var(--link); text-decoration: none; }
.title:hover { text-decoration: underline; }
.kind {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--secondary);
  border: 1px solid color-mix(in srgb, var(--secondary) 40%, transparent);
  border-radius: 999px;
  padding: 1px 8px;
}
.url {
  font-size: 12px;
  color: var(--muted);
  word-break: break-all;
  margin-top: 2px;
}
.summary {
  margin-top: 5px;
  color: color-mix(in srgb, var(--text) 78%, transparent);
  /* Auto-detect direction per item so an English summary in an RTL
     page keeps its trailing period at the line end. */
  unicode-bidi: plaintext;
}
.kind { unicode-bidi: isolate; }
.links {
  display: flex; flex-wrap: wrap; gap: 8px;
  margin-top: 6px; font-size: 13px;
}
.local-link, .ext-link {
  text-decoration: none;
  padding: 2px 10px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--link) 30%, transparent);
  color: var(--link);
}
.local-link:hover, .ext-link:hover {
  background: color-mix(in srgb, var(--link) 10%, transparent);
  text-decoration: none;
}
.ext-link { color: var(--secondary); border-color: color-mix(in srgb, var(--secondary) 35%, transparent); }
.ext-link:hover { background: color-mix(in srgb, var(--secondary) 10%, transparent); }
.extras { margin-top: 6px; font-size: 12px; }
.extras a { margin-right: 10px; color: var(--accent); }
.skipped {
  margin-top: 32px;
  padding: 14px 18px;
  background: color-mix(in srgb, var(--danger) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
  border-radius: 8px;
  font-size: 13px;
}
.skipped h2 { margin: 0 0 8px; font-size: 14px; color: var(--danger); }
.skipped ul { margin: 0; padding-left: 18px; }
.page-footer {
  margin-top: 36px;
  padding-top: 14px;
  border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
  color: var(--muted);
  font-size: 12px;
  text-align: center;
}
/* RTL: don't override grid-template-columns. CSS Grid lays columns
   along the inline axis, so with dir="rtl" column 1 is already at
   the visual right — the thumb (source order 1) lands there and
   the 1fr body column lands on the left. Overriding to `1fr 88px`
   silently swapped which item went into which column, squashing
   the body into 88px. Keep the LTR sizing + per-item plaintext
   inference for the title. */
[dir="rtl"] .title { unicode-bidi: plaintext; }
</style>
</head>
<body>
<main class="wrap">
  <h1>{{ title }}</h1>
  <p class="meta"><bdi>{{ items|length }} item{% if items|length != 1 %}s{% endif %} · generated {{ generated_at }}</bdi></p>
  {% if show_search %}<input class="filter" type="search" id="filter" placeholder="Filter… (title, URL)">{% endif %}
  <ul class="items" id="results">
    {%- for it in items %}
    <li class="item" data-search="{{ ((it.title or '') ~ ' ' ~ (it.url or '') ~ ' ' ~ (it.kind or ''))|lower }}">
      <a class="thumb" href="./files/{{ it.filename }}" target="_blank" rel="noopener">
        {%- if it.thumb %}<img src="./files/{{ it.thumb }}" alt="">
        {%- else %}{{ {'video':'🎬','photo':'🖼','document':'📄'}.get(it.plan, '🔖') }}
        {%- endif %}
      </a>
      <div>
        <div class="head">
          <a class="title" href="./files/{{ it.filename }}" target="_blank" rel="noopener"><bdi>{{ it.title or '(untitled)' }}</bdi></a>
          <span class="kind"><bdi>{{ it.plan }}</bdi></span>
        </div>
        <div class="links">
          <a class="local-link" href="./files/{{ it.filename }}" target="_blank" rel="noopener">📂 offline copy</a>
          {% if it.url %}<a class="ext-link" href="{{ it.url|safe_href }}" target="_blank" rel="noopener noreferrer">🌐 open original ↗</a>{% endif %}
        </div>
        {% if it.summary %}<div class="summary">{{ it.summary }}</div>{% endif %}
        {% if it.extra_files %}
        <div class="extras">
          {%- for f in it.extra_files %}<a href="./files/{{ f }}" target="_blank" rel="noopener">📎 {{ f }}</a>{% endfor %}
        </div>
        {% endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>
  {% if skipped %}
  <section class="skipped">
    <h2>{{ skipped|length }} skipped</h2>
    <ul>
      {%- for s in skipped %}
      <li><strong>{{ s.title }}</strong> — {{ s.reason }}</li>
      {%- endfor %}
    </ul>
  </section>
  {% endif %}
  {% if footer_text %}<footer class="page-footer">{{ footer_text }}</footer>{% endif %}
</main>
{% if show_search %}
<script>
const f = document.getElementById('filter');
f.addEventListener('input', () => {
  const q = f.value.trim().toLowerCase();
  document.querySelectorAll('#results .item').forEach(li => {
    li.style.display = (!q || li.dataset.search.includes(q)) ? '' : 'none';
  });
});
</script>
{% endif %}
</body>
</html>
