#!/usr/bin/env python3
"""
booki — single entry point that dispatches to the core/ subcommands.

Usage:
    booki [global flags] <subcommand> [subcommand options]

Global flags (must precede the subcommand):
    --log-level LEVEL    DEBUG | INFO | WARNING | ERROR | CRITICAL
    -v                   shorthand for --log-level INFO
    -vv                  shorthand for --log-level DEBUG
    -q                   shorthand for --log-level WARNING

Environment:
    BOOKI_LOG_LEVEL      same effect as --log-level (flag wins if both set)

Subcommands:
    sync · ingest · chat · web · browse · download

Run `booki <subcommand> --help` for that subcommand's flags.
"""

from __future__ import annotations

import importlib
import os
import sys
from pathlib import Path
from typing import Optional


SUBCOMMANDS: dict[str, str] = {
    "sync":      "core.sync",
    "ingest":    "core.ingest",
    "chat":      "core.chat",
    "web":       "core.web",
    "browse":    "core.browse",
    "download":  "core.download",
    "doctor":    "core.doctor",
    "bootstrap": "core.bootstrap",
}

PROJECT_ROOT = Path(__file__).resolve().parent
DEFAULT_CONFIG = PROJECT_ROOT / "config.toml"

VALID_LEVELS = {"DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"}


def _print_usage(stream=sys.stdout) -> None:
    bin_name = Path(sys.argv[0]).name or "booki"
    print(f"usage: {bin_name} [global flags] <subcommand> [options]", file=stream)
    print("", file=stream)
    print("global flags:", file=stream)
    print("  --log-level LEVEL    DEBUG | INFO | WARNING | ERROR | CRITICAL", file=stream)
    print("  -v / -vv             INFO / DEBUG", file=stream)
    print("  -q                   WARNING", file=stream)
    print("", file=stream)
    print("subcommands:", file=stream)
    for name in SUBCOMMANDS:
        print(f"  {name}", file=stream)
    print("", file=stream)
    print(f"Run `{bin_name} <subcommand> --help` for subcommand options.", file=stream)


def _split_global_args(argv: list[str]) -> tuple[Optional[str], list[str]]:
    """
    Pull global logging flags out of `argv` until we hit the first non-flag
    token (= the subcommand). Returns (level_override_or_None, remaining_argv).

    `remaining_argv[0]` is the subcommand (or the list is empty).
    """
    level: Optional[str] = None
    i = 0
    n = len(argv)
    while i < n:
        tok = argv[i]
        if tok == "-v":
            level = "INFO"
            i += 1
            continue
        if tok == "-vv":
            level = "DEBUG"
            i += 1
            continue
        if tok == "-q":
            level = "WARNING"
            i += 1
            continue
        if tok == "--log-level":
            if i + 1 >= n:
                print("booki: --log-level requires a value", file=sys.stderr)
                sys.exit(2)
            level = argv[i + 1].upper()
            i += 2
            continue
        if tok.startswith("--log-level="):
            level = tok.split("=", 1)[1].upper()
            i += 1
            continue
        # First non-flag token: stop, return everything from here as sub-argv.
        return level, argv[i:]
    return level, []


def main() -> None:
    sys.path.insert(0, str(PROJECT_ROOT))

    level_override, remaining = _split_global_args(sys.argv[1:])

    # CLI flag wins over env var.
    if level_override is None:
        env_lvl = os.environ.get("BOOKI_LOG_LEVEL", "").strip().upper()
        if env_lvl:
            level_override = env_lvl

    if level_override is not None and level_override not in VALID_LEVELS:
        print(f"booki: invalid --log-level: {level_override} "
              f"(expected one of: {', '.join(sorted(VALID_LEVELS))})",
              file=sys.stderr)
        sys.exit(2)

    # Configure logging once, before any subcommand work.
    from core.logs import load_logs_config, setup_logging
    setup_logging(load_logs_config(DEFAULT_CONFIG), level_override=level_override)

    if not remaining or remaining[0] in {"-h", "--help", "help"}:
        _print_usage()
        sys.exit(0 if remaining else 2)

    sub = remaining[0]
    module_path = SUBCOMMANDS.get(sub)
    if module_path is None:
        print(f"booki: unknown subcommand: {sub}", file=sys.stderr)
        _print_usage(sys.stderr)
        sys.exit(2)

    sys.argv = [f"booki {sub}", *remaining[1:]]

    import logging
    logging.getLogger("booki").debug("dispatch", extra={
        "subcommand": sub, "argv": remaining[1:],
    })

    module = importlib.import_module(module_path)
    if not hasattr(module, "main"):
        print(f"booki: {module_path} has no main() to dispatch to", file=sys.stderr)
        sys.exit(1)
    module.main()


if __name__ == "__main__":
    main()
